apiVersion: apps/v1
kind: Deployment
metadata:
  name: ai-model-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ai-model-app
  template:
    metadata:
      labels:
        app: ai-model-app
    spec:
      containers:
        - name: ai-model-app
